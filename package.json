{
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules .turbo dist apps/server/node_modules apps/web/node_modules packages/*/node_modules apps/server/dist apps/web/dist packages/*/dist apps/server/.wrangler node_modules/.vite apps/web/node_modules/.vite",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter=@repo/server db:generate",
    "db:migrate:local": "pnpm --filter=@repo/server db:migrate:local",
    "db:migrate:remote": "pnpm --filter=@repo/server db:migrate:remote",
    "db:list": "pnpm --filter=@repo/server db:list",
    "db:list:local": "pnpm --filter=@repo/server db:list:local",
    "db:apply": "pnpm --filter=@repo/server db:apply",
    "db:apply:local": "pnpm --filter=@repo/server db:apply:local",
    "ui-add": "turbo run ui-add --ui=tui",
    "create:route": "pnpm --filter=@repo/server create:route"
  },
  "devDependencies": {
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@8.15.6",
  "name": "pk-pocket-cube",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@>=5.0.0 <5.4.18": ">=5.4.18"
    }
  }
}

